# Closest Chemistry — copy to .env and fill real values.
# Missing credentials produce actionable configuration errors. Do not invent keys.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase Postgres / Auth / Storage ---
# Use the transaction or session pooler URI. SQLAlchemy driver prefix: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_SSL_REQUIRE=true
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
JWT_ISSUER=https://PROJECT.supabase.co/auth/v1
SUPABASE_STORAGE_BUCKET=closest-chemistry-private

# Frontend public keys (same Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Gemini image understanding ---
# Documented vision models only: gemini-3.8-flash, gemini-3.5-flash-lite,
# gemini-3.6-flash, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROMPT_VERSION=garment-extract-v1

# --- YouCam / Perfect Corp AI Clothes ---
# Official flow: POST /s2s/v2.0/file → PUT bytes → POST /s2s/v2.0/task/cloth-v4 → GET task
YOU_CAM_API_KEY=
YOU_CAM_BASE_URL=https://yce-api-01.makeupar.com
YOU_CAM_ENGINE_VERSION=cloth-v4
YOU_CAM_UNIT_COST=2
# Enable only live-verified categories. Official enum: upper_body,lower_body,full_body,shoes,outer,auto
# Leave empty until consented live tests succeed. Lower-body product-only references are documented as unsupported.
YOU_CAM_ENABLED_CATEGORIES=
YOU_CAM_POLL_INTERVAL_SECONDS=10
YOU_CAM_POLL_TIMEOUT_SECONDS=180
YOU_CAM_WEBHOOK_SECRET=

# --- Budgets / quotas / retention ---
DAILY_SPEND_CAP_UNITS=40
PER_USER_CONCURRENCY=2
MAX_PROVIDER_ATTEMPTS=3
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=5
MAX_OUTFIT_PHOTOS=15
MAX_UPLOAD_BYTES=10485760
RETENTION_DAYS=90
LOCAL_STORAGE_DIR=.local_storage
