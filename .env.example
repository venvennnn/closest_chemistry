# Closest Chemistry — copy to .env and fill real values.
# There is no sign-in. One shared anonymous session owns the closet (AUTH_MODE=single).

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTH_MODE=single
SINGLE_OWNER_ID=local
CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (Render Postgres, Compose, or any URI) ---
# SQLAlchemy driver prefix: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://chemistry:chemistry@localhost:5432/closest_chemistry
DATABASE_SSL_REQUIRE=false

# Optional: private object storage. If unset, photos stay on the API disk (LOCAL_STORAGE_DIR).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=closest-chemistry-private

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Gemini image understanding ---
# Documented vision models only: gemini-3.8-flash, gemini-3.5-flash-lite,
# gemini-3.6-flash, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROMPT_VERSION=garment-extract-v1

# --- YouCam / Perfect Corp AI Clothes ---
YOU_CAM_API_KEY=
YOU_CAM_BASE_URL=https://yce-api-01.makeupar.com
YOU_CAM_ENGINE_VERSION=cloth-v4
YOU_CAM_UNIT_COST=2
YOU_CAM_ENABLED_CATEGORIES=
YOU_CAM_POLL_INTERVAL_SECONDS=10
YOU_CAM_POLL_TIMEOUT_SECONDS=180
YOU_CAM_WEBHOOK_SECRET=

# --- Budgets / quotas / retention ---
DAILY_SPEND_CAP_UNITS=40
PER_USER_CONCURRENCY=2
MAX_PROVIDER_ATTEMPTS=3
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=20
JOB_MAX_ATTEMPTS=5
MAX_OUTFIT_PHOTOS=15
MAX_UPLOAD_BYTES=10485760
RETENTION_DAYS=90
LOCAL_STORAGE_DIR=.local_storage
